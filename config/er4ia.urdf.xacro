<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="er4ia">
  <!-- Use the official FANUC LR Mate ER-4iA model. -->
  <xacro:include filename="$(find fanuc_lrmate_description)/urdf/er4ia_urdf_macro.xacro"/>

  <!-- Add the robot as a self-contained mock ros2_control system for the demo. -->
  <xacro:include filename="er4ia.ros2_control.xacro"/>

  <link name="world"/>
  <xacro:er4ia parent="world" child="ee_link">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:er4ia>
  <link name="ee_link"/>

  <xacro:er4ia_ros2_control
    name="FakeSystem"
    initial_positions_file="$(find fanuc_er4ia_moveit_config)/config/initial_positions.yaml"
  />
</robot>
